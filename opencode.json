{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": {
    "paths": [".ai/skills"]
  },
  "command": {
    "integration-tests": {
      "description": "Integration coverage for one or more user stories (see .ai/skills/integration-tests)",
      "template": "Read .ai/skills/integration-tests/SKILL.md in full and follow it step by step, using this input as the user story text with its acceptance criteria:\n\n$ARGUMENTS"
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*master.key": "deny",
      "*credentials*.key": "deny",
      "*credentials.yml.enc": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*id_rsa*": "deny"
    },
    "grep": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*master.key*": "deny",
      "*credentials*": "deny",
      "*.pem*": "deny",
      "*id_rsa*": "deny",
      "env": "deny",
      "printenv*": "deny"
    }
  }
}
